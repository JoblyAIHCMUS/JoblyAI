{
  "java.compile.nullAnalysis.mode": "automatic",
  "prisma.pinToPrisma6": true,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/android/build/**"
  ],
  "java.project.resourceFilters": ["node_modules", ".git", "**/android/build"]
}
