node-linker=hoisted
package-import-method=copy
force-legacy-deploy=true
# pnpm 10.x still hits the retired npm /security/audits endpoints regardless of
# the audit-endpoint setting; the `pnpm run audit` script bypasses npm entirely
# and queries OSV.dev. See scripts/audit.mjs for details.
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*react-native-reanimated*
public-hoist-pattern[]=*react-native-worklets*
public-hoist-pattern[]=*expo*