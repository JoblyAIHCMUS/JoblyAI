{
  "expo": {
    "owner": "joblyai-vn",
    "name": "JoblyAI",
    "slug": "joblyai-vn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcons/appstore.png",
    "scheme": "jobly",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "experiments": {
      "tsconfigPaths": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobly.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AppIcons/android/adaptive-foreground.png",
        "monochromeImage": "./assets/images/AppIcons/android/adaptive-foreground.png",
        "backgroundColor": "#4F46E5"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jobly.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/AppIcons/appstore.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4F46E5"
        }
      ],
      "expo-router",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-notifications",
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/images/AppIcons/appstore.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "owner": "joblyai-vn",
        "projectId": "4626adf7-30c9-41b0-9c84-affebf310094"
      }
    }
  }
}
