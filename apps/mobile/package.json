{
  "name": "@jobly/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "run-android": "node ../../node_modules/react-native/cli.js run-android",
    "run-ios": "node ../../node_modules/react-native/cli.js run-ios",
    "build-android": "cd android && ./gradlew assembleRelease",
    "build-ios": "cd ios && xcodebuild -workspace Mobile.xcworkspace -scheme Mobile -configuration Release -sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath build CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY= DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER= build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-native/metro-config": "*",
    "lucide-react-native": "^1.11.0",
    "metro-config": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@types/react-native-vector-icons": "^6.4.18"
  }
}
