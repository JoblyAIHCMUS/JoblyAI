# Better Auth
BETTER_AUTH_SECRET=changeme
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173
PORT=3000
NODE_ENV=development

# Redis
REDIS_URL=redis://redis:6379

# Postgres
POSTGRES_USER=jobly
POSTGRES_PASSWORD=jobly
POSTGRES_DB=jobly_db
DATABASE_URL=postgres://jobly:jobly@postgres:5432/jobly_db

# ScyllaDB
SCYLLA_HOST=scylla
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=jobly

# Gemini
GEMINI_KEY=changeme
GEMINI_MAIN_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL_1=gemini-2.5-flash
GEMINI_FALLBACK_MODEL_2=gemini-2.5-flash-lite

# S3 (Legacy - keep for reference)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=ap-southeast-1
# S3_BUCKET_NAME=jobly-dev-assets
# S3_UPLOAD_EXPIRY=300

# GCS (Google Cloud Storage)
GCS_PROJECT_ID=your-project-id
GCS_PUBLIC_BUCKET=jobly-public-assets
GCS_PRIVATE_BUCKET=jobly-private-resumes
GCS_UPLOAD_EXPIRY=300
GCS_KEY_FILE=./gcs-key.json


# Github OAuth
GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme

# Google OAuth
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# Mailing
MAILER_HOST=smtp.mailtrap.io
MAILER_PORT=2525
MAILER_USER=your_mailtrap_user
MAILER_PASSWORD=your_mailtrap_password