generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  banExpires    DateTime?
  banReason     String?
  banned        Boolean?  @default(false)
  role          String?   @default("candidate")
  firstName     String?
  lastName      String?
  phoneNumber   String?
  dateOfBirth   DateTime?
  gender        Gender?

  employer             Employer?
  postedJobs           JobPosting[]
  accounts             Account[]
  sessions             Session[]
  education            Education[]
  experiences          Experience[]
  certificates         Certificate[]
  resumes              Resume[]
  candidateDescription CandidateDescription?
  candidateSkills      CandidateSkill[]
  candidateContacts    CandidateContact[]
  candidateSocials     CandidateSocial[]
  conversations        Conversation[]        @relation("UserConversations")
  participating        Conversation[]        @relation("ParticipantInConversations")
  applications         Application[]
  notifications        Notification[]

  @@map("user")
}

model Conversation {
  id            Int      @id @default(autoincrement())
  ownerId       String
  owner         User     @relation("UserConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  participantId String
  participant   User     @relation("ParticipantInConversations", fields: [participantId], references: [id], onDelete: Cascade)
  lastMessage   String?
  lastMessageAt DateTime @default(now())
  scyllaChatId  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerId, participantId])
  @@index([ownerId, lastMessageAt(sort: Desc)])
  @@map("conversation")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@map("verification")
}

model JobCategory {
  id   Int          @id @default(autoincrement())
  name String       @unique
  slug String       @unique
  iconKey String?
  jobs JobPosting[]
}

model Skill {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  requirements    JobRequirement[]
  candidateSkills CandidateSkill[]
}

model JobPosting {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  location    String?
  salaryMin   Decimal?
  salaryMax   Decimal?
  currency    String?        @default("USD")
  status      JobStatus      @default(DRAFT)
  remote      Boolean        @default(false)
  type        EmploymentType @default(FULL_TIME)
  embedding   Unsupported("vector(3072)")?

  postedById String
  postedBy   User   @relation(fields: [postedById], references: [id])

  categoryId Int
  category   JobCategory @relation(fields: [categoryId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  requirements JobRequirement[]
  applications Application[]
  views        JobView[]
}

model JobRequirement {
  id                 Int                   @id @default(autoincrement())
  jobPostingId       Int
  skillId            Int
  importance         RequirementImportance @default(PREFERRED)
  minYearsExperience Int?
  jobPosting         JobPosting            @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skill              Skill                 @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, skillId])
}

model Education {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  school       String
  degree       Degree?
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  grade        String?
  description  String?
  sourceCvIds  Int[]
  embedding    Unsupported("vector(3072)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model Experience {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  companyName String
  jobTitle    String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  type        CandidateExperienceType?
  sourceCvIds Int[]
  embedding   Unsupported("vector(3072)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model CandidateDescription {
  id          Int      @id @default(autoincrement())
  candidateId String   @unique
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  title           String?                     @db.Text
  bio             String?                     @db.Text
  rawDescriptions Json?
  rawTitles       Json?
  embedding       Unsupported("vector(3072)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model CandidateSkill {
  id          Int      @id @default(autoincrement())
  candidateId String
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  skillId     Int
  skill       Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level       CandidateSkillLevel?
  years       Int?
  sourceCvIds Int[]
  embedding   Unsupported("vector(3072)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([skillId])
  @@unique([candidateId, skillId])
}

model CandidateContact {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  type        CandidateContactType?
  value       String
  isPrimary   Boolean               @default(false)
  sourceCvIds Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model CandidateSocial {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  platform    CandidateSocialPlatform
  url         String
  username    String?
  sourceCvIds Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model Certificate {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  name         String
  issuer       String
  issueDate    DateTime
  expiryDate   DateTime?
  credentialId String?
  url          String?
  sourceCvIds  Int[]
  embedding    Unsupported("vector(3072)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model Company {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  slug         String     @unique
  websiteUrl  String?
  sizeRange   String?
  industry    String?
  description String?
  logoUrl     String?
  adminId     Int?       @unique
  admin       Employer?  @relation("CompanyAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employers   Employer[] @relation("CompanyEmployers")
  jobPostings JobPosting[]
}

model Employer {
  id         Int      @id @default(autoincrement())
  companyId  Int?
  company    Company? @relation("CompanyEmployers", fields: [companyId], references: [id], onDelete: SetNull)
  employerId String   @unique
  employer   User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  adminFor   Company? @relation("CompanyAdmin")
  role       String
  assignedAt DateTime @default(now())

  @@index([companyId])
  @@index([employerId])
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum RequirementImportance {
  REQUIRED
  PREFERRED
  OPTIONAL
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

model Resume {
  id                Int           @id @default(autoincrement())
  candidateId       String
  candidate         User          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileKey           String?
  fileName          String
  fileType          String
  fileSize          Int
  parsedText        String?       @db.Text
  aiScore           Float?
  aiFeedback        Json?
  isSyncedToProfile Boolean       @default(true)
  isDefault         Boolean       @default(false)
  embedding         Unsupported("vector(3072)")?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  applications      Application[]

  @@index([candidateId])
  @@map("resume")
}

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String   // e.g., "NEW_MESSAGE", "APPLICATION_STATUS", "NEW_APP"
  title       String
  content     String
  link        String?  // URL to redirect when clicked
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  metadata    Json?    // Extra info (senderId, jobId, etc.)

  @@index([recipientId])
  @@index([isRead])
  @@map("notification")
}

model Application {
  id               Int               @id @default(autoincrement())
  jobId            Int
  job              JobPosting        @relation(fields: [jobId], references: [id])
  candidateId      String
  candidate        User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resumeId         Int
  resume           Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  matchPercentage  Float?
  aiFeedback       Json?
  status           ApplicationStatus @default(APPLIED)
  jobDeletedAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@map("application")
}

enum ApplicationStatus {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobView {
  id        Int        @id @default(autoincrement())
  jobId     Int
  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  viewedAt  DateTime   @default(now())

  @@index([jobId, viewedAt])
  @@index([viewedAt])
  @@map("job_view")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CandidateExperienceType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  ONSITE
  REMOTE
  HYBRID
  OTHER
}

enum CandidateSkillLevel {
  NOVICE
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MASTER
}

enum CandidateContactType {
  PHONE
  EMAIL
  FAX
  WEBSITE
  LINKEDIN
  GITHUB
  OTHER
}

enum CandidateSocialPlatform {
  LINKEDIN
  GITHUB
  FACEBOOK
  TWITTER
  INSTAGRAM
  YOUTUBE
  TIKTOK
  DRIBBBLE
  BEHANCE
  OTHER
}

enum Degree {
  HIGH_SCHOOL
  DIPLOMA
  ASSOCIATE
  BACHELOR
  MASTER
  PHD
  OTHER
}
