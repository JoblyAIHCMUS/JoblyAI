// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  role          String?       @default("candidate")
  banned        Boolean?      @default(false)
  banReason     String?
  banExpires    DateTime?
  firstName     String?
  lastName      String?
  postedJobs     JobPosting[]
  education      Education[]
  experiences    Experience[]
  certificates   Certificate[]
  resumes        Resume[]
  employerRoles  EmployerRole[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@map("verification")
}

// Job models
model JobCategory {
  id   Int          @id @default(autoincrement())
  name String       @unique
  slug String       @unique
  jobs JobPosting[]
}

model Skill {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  requirements JobRequirement[]
}

model JobPosting {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  location    String?
  salaryMin   Decimal?
  salaryMax   Decimal?
  currency    String?        @default("USD")
  status      JobStatus      @default(DRAFT)
  remote      Boolean        @default(false)
  type        EmploymentType @default(FULL_TIME)

  // Relations
  postedById String
  postedBy   User   @relation(fields: [postedById], references: [id])

  categoryId Int
  category   JobCategory @relation(fields: [categoryId], references: [id])

  companyName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements JobRequirement[]
}

model JobRequirement {
  id           Int        @id @default(autoincrement())
  jobPostingId Int
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  skillId Int
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  importance         RequirementImportance @default(PREFERRED)
  minYearsExperience Int?

  @@unique([jobPostingId, skillId])
}

model Education {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  school       String // University or School name
  degree       String? // e.g., "Bachelor of Science", "High School Diploma"
  fieldOfStudy String? // e.g., "Computer Science"
  startDate    DateTime
  endDate      DateTime? // Nullable: If null, it means "Present" (currently studying)
  grade        String? // e.g., "3.8 GPA" or "Distinction"
  description  String? // Optional description of the education experience

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model Experience {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  companyName String
  jobTitle    String
  location    String?
  startDate   DateTime
  endDate     DateTime? // Nullable: If null, it means "Present" (currently working)
  description String? // Optional description of the work experience

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model Certificate {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  name         String
  issuer       String
  issueDate    DateTime
  expiryDate   DateTime? // Nullable: If null, it means "No Expiry"
  credentialId String? // Optional credential ID or license number
  url          String? // Optional URL to the certification details

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
}

model Resume {
  id          Int    @id @default(autoincrement())
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  fileUrl   String // URL to the uploaded resume file (e.g., S3 link)
  fileName  String // Original name of the uploaded file (e.g., "resume.pdf")
  fileType  String // MIME type of the resume file (e.g., "application/pdf")
  fileSize  Int // Size of the resume file in bytes
  isDefault Boolean @default(false) // Indicates if this is the candidate's default resume

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // I think AI scoring should be a separate model to allow for multiple scores over time
  // same as parsed text and embedding
  @@index([candidateId])
}

model Company {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  websiteUrl  String?
  sizeRange   String?
  industry    String?
  description String?
  logoUrl     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  employers   EmployerRole[]
}

model EmployerRole {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employerId String
  employer   User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  role       String
  assignedAt DateTime @default(now())

  @@unique([companyId, employerId])
  @@index([companyId])
  @@index([employerId])
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum RequirementImportance {
  REQUIRED
  PREFERRED
  OPTIONAL
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}
