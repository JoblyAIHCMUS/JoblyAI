{
  "name": "@jobly/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "auth:schema": "pnpm dlx @better-auth/cli@latest generate --config ./src/lib/auth.ts --output ./prisma/schema.prisma",
    "auth:setup": "pnpm run auth:schema && prisma migrate dev && prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/backend"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/backend/dist/package.json",
          "{workspaceRoot}/apps/backend/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/backend/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@jobly/backend:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@jobly/backend:build:development"
          },
          "production": {
            "buildTarget": "@jobly/backend:build:production"
          }
        }
      },
      "quality-gate": {
        "executor": "nx:noop",
        "dependsOn": [
          "lint",
          "test",
          "build"
        ]
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm test",
          "cwd": "apps/backend"
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.5",
    "@prisma/adapter-pg": "^6.3.0",
    "@prisma/client": "^6.3.0",
    "@types/cassandra-driver": "^4.2.4",
    "better-auth": "^1.4.18",
    "cassandra-driver": "^4.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "ioredis": "^5.9.2",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.18",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.17",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "prisma": "^6.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2"
  }
}
